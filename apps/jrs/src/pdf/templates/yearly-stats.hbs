<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Yearly Statistics Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        h1 { color: #333; text-align: center; }
        .summary { background: #f5f5f5; padding: 20px; margin-bottom: 30px; border-radius: 5px; }
        .stats-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .stats-table th, .stats-table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .stats-table th { background-color: #f2f2f2; }
        .chart-container { margin: 30px 0; text-align: center; }
        .footer { margin-top: 50px; text-align: center; color: #666; font-size: 12px; }
        .monthly-stats { margin-bottom: 30px; }
    </style>
</head>
<body>
    <h1>Yearly Statistics Report</h1>
    <div class="summary">
        <h2>Summary</h2>
        <p><strong>Year:</strong> {{year}}</p>
        <p><strong>Total JRS Members:</strong> {{yearlyStats.totals.jrs}}</p>
        <p><strong>Total Non-JRS Attendees:</strong> {{yearlyStats.totals.nonJrs}}</p>
        <p><strong>Total Activities:</strong> {{yearlyStats.totals.activities}}</p>
        <p><strong>Generated At:</strong> {{generatedAt}}</p>
    </div>
    
    <div class="monthly-stats">
        <h2>Monthly Breakdown</h2>
        <table class="stats-table">
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Activities</th>
                    <th>JRS Count</th>
                    <th>Non-JRS Count</th>
                </tr>
            </thead>
            <tbody>
                {{#each yearlyStats.monthlyStats}}
                <tr>
                    <td>{{this.month}}</td>
                    <td>{{this.activities.length}}</td>
                    <td>
                        {{#reduce this.activities 0 (sum activity) (sum activity.jrsCount) }}
                    </td>
                    <td>
                        {{#reduce this.activities 0 (sum activity) (sum activity.nonJrsCount) }}
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    
    <div class="footer">
        <p>Generated by JRS Reporting System</p>
    </div>
</body>
</html>