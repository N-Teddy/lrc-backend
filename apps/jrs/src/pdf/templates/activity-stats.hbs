<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Activity Statistics Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        h1 { color: #333; text-align: center; }
        .summary { background: #f5f5f5; padding: 20px; margin-bottom: 30px; border-radius: 5px; }
        .stats-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .stats-table th, .stats-table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .stats-table th { background-color: #f2f2f2; }
        .chart-container { margin: 30px 0; text-align: center; }
        .footer { margin-top: 50px; text-align: center; color: #666; font-size: 12px; }
    </style>
</head>
<body>
    <h1>Activity Statistics Report</h1>
    <div class="summary">
        <h2>Summary</h2>
        <p><strong>Activity ID:</strong> {{activityId}}</p>
        <p><strong>JRS Members:</strong> {{jrsCount}}</p>
        <p><strong>Non-JRS Attendees:</strong> {{nonJrsCount}}</p>
        <p><strong>Generated At:</strong> {{generatedAt}}</p>
    </div>
    
    <div class="chart-container">
        <h2>Grade Breakdown</h2>
        <!-- Chart will be inserted here by JavaScript in a real implementation -->
        <!-- For now, we'll show a table -->
        <table class="stats-table">
            <thead>
                <tr>
                    <th>Grade</th>
                    <th>Count</th>
                </tr>
            </thead>
            <tbody>
                {{#if gradeBreakdown}}
                    {{#each gradeBreakdown}}
                    <tr>
                        <td>{{this.gradeName}}</td>
                        <td>{{this.count}}</td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="2">No grade data available</td>
                    </tr>
                    {{/if}}
            </tbody>
        </table>
    </div>
    
    <div class="footer">
        <p>Generated by JRS Reporting System</p>
    </div>
</body>
</html>