<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Member Statistics Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        h1 { color: #333; text-align: center; }
        .summary { background: #f5f5f5; padding: 20px; margin-bottom: 30px; border-radius: 5px; }
        .stats-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; }
        .stats-table th, .stats-table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .stats-table th { background-color: #f2f2f2; }
        .footer { margin-top: 50px; text-align: center; color: #666; font-size: 12px; }
    </style>
</head>
<body>
    <h1>Member Statistics Report</h1>
    <div class="summary">
        <h2>Summary</h2>
        <p><strong>Member ID:</strong> {{memberId}}</p>
        <p><strong>Year:</strong> {{year}}</p>
        <p><strong>Month:</strong> {{month}}</p>
        <p><strong>Generated At:</strong> {{generatedAt}}</p>
    </div>
    
    <table class="stats-table">
        <thead>
            <tr>
                <th>Metric</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Total Activities in Period</td>
                <td>{{memberStats.totalActivitiesInPeriod}}</td>
            </tr>
            <tr>
                <td>Attended Activities</td>
                <td>{{memberStats.attendedActivities}}</td>
            </tr>
            <tr>
                <td>Attendance Rate</td>
                <td>{{ (memberStats.attendanceRate * 100).toFixed(2) }}%</td>
            </tr>
        </tbody>
    </table>
    
    <div class="footer">
        <p>Generated by JRS Reporting System</p>
    </div>
</body>
</html>