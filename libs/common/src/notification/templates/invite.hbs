<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: Arial, sans-serif;
        background-color: #f0f2f5;
        padding: 32px 16px;
      }
      .wrapper {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      }
      .header {
        background: #1565c0;
        padding: 32px 24px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.5px;
      }
      .header p {
        color: #bbdefb;
        font-size: 13px;
        margin-top: 6px;
      }
      .body {
        padding: 32px 24px;
      }
      .greeting {
        font-size: 16px;
        color: #212121;
        margin-bottom: 16px;
      }
      .message {
        font-size: 14px;
        color: #424242;
        line-height: 1.7;
        margin-bottom: 24px;
      }
      .app-badge {
        display: inline-block;
        background: #e3f2fd;
        color: #1565c0;
        font-size: 13px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 12px;
        margin-bottom: 24px;
      }
      .cta-wrapper {
        text-align: center;
        margin: 28px 0;
      }
      .cta-button {
        display: inline-block;
        background: #1565c0;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        padding: 14px 32px;
        border-radius: 6px;
        text-decoration: none;
        letter-spacing: 0.3px;
      }
      .expiry-notice {
        background: #fff8e1;
        border-left: 4px solid #f9a825;
        padding: 12px 16px;
        border-radius: 4px;
        font-size: 13px;
        color: #5d4037;
        margin-bottom: 24px;
      }
      .expiry-notice strong {
        color: #e65100;
      }
      .divider {
        border: none;
        border-top: 1px solid #eeeeee;
        margin: 24px 0;
      }
      .security-note {
        font-size: 12px;
        color: #757575;
        line-height: 1.6;
      }
      .footer {
        background: #f5f5f5;
        padding: 20px 24px;
        text-align: center;
        font-size: 12px;
        color: #9e9e9e;
        border-top: 1px solid #eeeeee;
      }
      .footer strong {
        color: #616161;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h1>You've been invited</h1>
        <p>LRC Ecosystem — System Access</p>
      </div>

      <div class="body">
        <p class="greeting">Hello {{fullName}},</p>

        <p class="message">
          You have been granted access to the LRC system. An account has been
          created for you and is ready to be activated.
        </p>

        {{#if appName}}
        <div>
          <span class="app-badge">{{appName}}</span>
        </div>
        {{/if}}

        <p class="message">
          To get started, click the button below to set up your password and
          activate your account. This is a one-time link — it can only be used
          once.
        </p>

        <div class="cta-wrapper">
          <a href="{{actionUrl}}" class="cta-button">Set Up My Account</a>
        </div>

        <div class="expiry-notice">
          ⏱ This invitation link will expire in
          <strong>{{expiresIn}}</strong>. If it has expired, contact your
          administrator to request a new one.
        </div>

        <hr class="divider" />

        <p class="security-note">
          If you were not expecting this invitation or do not recognise this
          request, you can safely ignore this email. Your account will not be
          activated until you click the link above. Do not share this link with
          anyone.
        </p>
      </div>

      <div class="footer">
        <p><strong>LRC Ecosystem</strong></p>
        <p style="margin-top: 4px;">This is an automated message — please do not reply to this email.</p>
      </div>
    </div>
  </body>
</html>
